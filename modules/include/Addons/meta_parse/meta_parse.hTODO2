  class Parser {
    RG_Array<wstring> Error = RG_Array<wstring>(1, L"Not_Found");
    wstring source;
    uint pos = 0;
  public:
    struct Node {
      wstring key;
      RG_Array<wstring> value;
      RG::Pointer<Node> parent;
      RG_Array<RG::Pointer<Node>> childrens;
      Node() {};
      Node(wstring& k, wstring v) :key(k), value(1, v) {}
      Node(wstring& k, RG_Array<wstring> v) :key(k), value(v) {}
    };
    RG::Pointer<Node> root;

    void loadinit(const wstring& path) {
      source = (RG::WFileLoad(path));
      if (source == RG_ERROR_WSTRING) {
        RG_LOG_LOCK_WARNING(L"File " + path + L" not found!");
        return;
      }
    }
    void loadinit(const string& path) {
      source = (RG::WFileLoad(path));
      if (source == RG_ERROR_WSTRING) {
        RG_LOG_LOCK_WARNING("File " + path + " not found!");
        return;
      }
    }


    void init(void) {
      if (source.size() == 0)return;
      if (root) { clear(); }
      root = parse();
      root->key = L"main";
    }
    void init(wstring in) {
      if (in == RG_ERROR_WSTRING) {
        RG_LOG_LOCK_ERROR("File in parse load with error");
        return;
      }
      source = (in);
      init();
    };
    void init(string in) {
      if (in == RG_ERROR_STRING) {
        RG_LOG_LOCK_ERROR("File in parse load with error");
        return;
      }
      source = (utf8_decode(in));
      init();
    };
    Parser(wstring in) :source(in) {
      init();
    };
    Parser(string in) :source(utf8_decode(in)) {
      init();
    };
    Parser() {};
    Node* parse() {
      Node* node = RG::s_new<Node>(1);
      wstring temp, tempKey;
      RG_Array<wstring>ttemp;
      // RG_Array tempKey(1);
      bool quotes = false;
      bool array = false;
      for (;pos < source.size();pos++) {
        // Sleep(60);
        if (source[pos] == '[' && pos == 0 || source[pos] == '[' && source[pos - 1] != '\\') {
          ttemp.clear();
          array = 1;
          pos++;
        } else
          if (source[pos] == '"' && pos == 0 || source[pos] == '"' && source[pos - 1] != '\\') {
            quotes = 1;
            pos++;
          }

        if (quotes) {
          for (;pos < source.size() && quotes;pos++) {
            // Sleep(60);
            if (source[pos] == '"' && pos == 0 || source[pos] == '"' && source[pos - 1] != '\\') { quotes = 0;pos++;break; }
            temp += source[pos];
          }
        }
        if (array) {
          for (;pos < source.size() && array;pos++) {
            // Sleep(60);
            if (source[pos] == '"' && pos == 0 || source[pos] == '"' && source[pos - 1] != '\\') {
              quotes = 1;
              pos++;
            }
            if (quotes) {
              for (;pos < source.size() && quotes;pos++) {
                // Sleep(60);
                if (source[pos] == '"' && pos == 0 || source[pos] == '"' && source[pos - 1] != '\\') { quotes = 0;pos++;break; }
                temp += source[pos];
              }
              ttemp.fastpush(temp);
              temp.clear();
            }
            if (source[pos] == ']' && pos == 0 || source[pos] == ']' && source[pos - 1] != '\\') { array = 0;pos++; break; }
          }
        }

        if (source[pos] == L'/' && pos < source.size() - 1 && source[pos + 1] == '/') {
          for (;pos < source.size() && source[pos] != '\n';pos++);continue;
        }
        if (source[pos] == '=') {
          tempKey = temp;
          temp.clear();
          continue;
        }
        if (source[pos] == '{') {
          pos++;
          // node = parse();
          Node* cld = parse();
          cld->key = temp;
          node->childrens.fastpush(cld);
          temp.clear();
          tempKey.clear();
          //node->childrens.push_back(parse());
          continue;
        }
        if (source[pos] == ',') {
          if (tempKey.size()) {
            if (ttemp.size()) {
              node->childrens.fastpush(RG::s_new<Node>(1, Node(tempKey, ttemp)));
              ttemp.clear();
            } else {
              node->childrens.fastpush(RG::s_new<Node>(1, Node(tempKey, temp)));
            }
            tempKey.clear();
            temp.clear();
          }
          continue;
        }
        if (source[pos] == '}') {
          if (tempKey.size()) {
            node->childrens.fastpush(RG::s_new<Node>(1, Node(tempKey, temp)));
            tempKey.clear();
            temp.clear();
          }
          break;
        }
        if (source[pos] > ' ' && !quotes) {
          temp += source[pos];
        }
      }
      return node;
    }

    // wstring operator[](wstring key){
    //   Node* node = root;
    //   wstring temp;
    //   for(int i = 0; i <= key.size();i++){
    //     if(key[i] == '\\' || key[i] == '/' || i == key.size()){
    //       for(int j = 0; j < node->childrens.size();j++){
    //         if(node->childrens[j]->key == temp){
    //           node = node->childrens[j];
    //           break;
    //         }
    //       }
    //       temp.clear();
    //       continue;
    //     } else
    //       temp += key[i];
    //   }
    //   if(node == root){
    //     return (key + L" not found");
    //   } else
    //     return node->value[0];
    // }
    RG_Array<wstring> operator[](wstring key) {
      Node* node = root;
      wstring temp;
      for (int i = 0; i <= key.size();i++) {
        if (key[i] == '\\' || key[i] == '/' || i == key.size()) {
          for (int j = 0; j < node->childrens.size();j++) {
            if (node->childrens[j]->key == temp) {
              node = node->childrens[j];
              break;
            }
          }
          temp.clear();
          continue;
        } else
          temp += key[i];
      }
      if (node == root) {
        // return (key + L" not found");
        return Error;
      } else
        return node->value;
    }
    RG_Array<wstring> get(wstring key) {
      Node* node = root;
      wstring temp;
      for (int i = 0; i <= key.size();i++) {
        if (key[i] == '\\' || key[i] == '/' || i == key.size()) {
          for (int j = 0; j < node->childrens.size();j++) {
            if (node->childrens[j]->key == temp) {
              node = node->childrens[j];
              break;
            }
          }
          temp.clear();
          continue;
        } else
          temp += key[i];
      }
      if (node == root) {
        // return (key + L" not found");
        return Error;
      } else
        return node->value;
    }
    wstring get(wstring key, int index) {
      Node* node = root;
      wstring temp;
      for (int i = 0; i <= key.size();i++) {
        if (key[i] == '\\' || key[i] == '/' || i == key.size()) {
          for (int j = 0; j < node->childrens.size();j++) {
            if (node->childrens[j]->key == temp) {
              node = node->childrens[j];
              break;
            }
          }
          temp.clear();
          continue;
        } else
          temp += key[i];
      }
      if (node == root) {
        // return (key + L" not found");
        return Error[0];
      } else {
        if (node->value.size() > index) {
          return node->value[index];
        } else {
          return Error[0];
        }

      }
    }


    void clear() {
      // if (root)RG::s_delete(root);
      root.clear();
    }
    ~Parser() {
      clear();
    }

    void print() {
      print(root);
    }
    int step = 0;
    void print(Node* in) {
      rg_cout << "\n";
      for (int i = 0;i < step;i++)rg_cout << "  ";
      rg_cout << L"Key: " << in->key << endl;
      if (in->value.size()) {
        for (int i = 0;i < step;i++)rg_cout << "  ";
        rg_cout << L"Value: "; in->value.print(); rg_cout << endl;
      }
      if (in->childrens.size()) {
        for (int i = 0;i < step;i++)rg_cout << "  ";
        rg_cout << L"Childrens: {";
        step++;
        for (int i = 0;i < in->childrens.size();i++) {
          print(in->childrens[i]);
        }
        step--;
        for (int i = 0;i < step;i++)rg_cout << "  ";
        rg_cout << L"}\n";
      }
    }
  };
}