prefix=C:\GLOBAL_PROJECT\CreationLib\glfw\build
exec_prefix=${prefix}
includedir=C:\GLOBAL_PROJECT\CreationLib\glfw\build/include
libdir=C:\GLOBAL_PROJECT\CreationLib\glfw\build/lib

Name: GLFW
Description: A multi-platform library for OpenGL, window and input
Version: 3.4.0
URL: https://www.glfw.org/
Requires.private: 
Libs: -L${libdir} -lglfw3
Libs.private:  -lgdi32
Cflags: -I${includedir}
