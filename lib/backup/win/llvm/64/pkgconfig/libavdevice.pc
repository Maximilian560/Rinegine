prefix=../build/64
exec_prefix=${prefix}
libdir=../build/64/lib
includedir=../build/64/include

Name: libavdevice
Description: FFmpeg device handling library
Version: 61.4.100
Requires: libavfilter >= 10.9.100, libswscale >= 8.13.103, libavformat >= 61.9.107, libavcodec >= 61.33.102, libswresample >= 5.4.100, libavutil >= 59.60.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavdevice -lpsapi -lole32 -lstrmiids -luuid -loleaut32 -lshlwapi -lgdi32 -lm -latomic -lvfw32
Libs.private: 
Cflags: -I${includedir}
