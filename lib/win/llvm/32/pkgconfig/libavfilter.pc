prefix=../32/build
exec_prefix=${prefix}
libdir=../32/build/lib
includedir=../32/build/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 10.9.100
Requires: libswscale >= 8.13.103, libpostproc >= 58.4.100, libavformat >= 61.9.107, libavcodec >= 61.33.102, libswresample >= 5.4.100, libavutil >= 59.60.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavfilter -lm -latomic
Libs.private: 
Cflags: -I${includedir}
