prefix=../build/64
exec_prefix=${prefix}
libdir=../build/64/lib
includedir=../build/64/include

Name: libavfilter
Description: FFmpeg audio/video filtering library
Version: 10.9.100
Requires: libswscale >= 8.13.103, libavformat >= 61.9.107, libavcodec >= 61.33.102, libswresample >= 5.4.100, libavutil >= 59.60.100
Requires.private: 
Conflicts:
Libs: -L${libdir}  -lavfilter -lm -latomic
Libs.private: 
Cflags: -I${includedir}
